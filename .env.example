# Copy to .env; choose passwords locally. Never commit .env or document samples.
APP_ENV=local
POSTGRES_DB=case3
POSTGRES_USER=case3
POSTGRES_PASSWORD=
DB_HOST=db
DB_PORT=5432
# Optional replacement for the above connection fields (also a server-only secret):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

BOOTSTRAP_SPECIALIST_USERNAME=specialist
BOOTSTRAP_SPECIALIST_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=administrator
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_HOURS=8
# False only for local HTTP. Production requires HTTPS and true.
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]

BLOB_BACKEND=postgres
# The isolated converter is connected by FMT01; it is not installed in the API image.
OFFICE_CONVERTER=disabled
MODEL_PROVIDER=local
LOCAL_BASE_URL=http://ollama:11434
LOCAL_MODEL=qwen3-vl:4b-instruct
LOCAL_TIMEOUT_SECONDS=300

OLMOCR_BASE_URL=https://ocr.ilons.ru
OLMOCR_API_TOKEN=
OLMOCR_TIMEOUT_SECONDS=300
# Application limits/profile label; actual remote deployment limits are still unconfirmed.
OLMOCR_PROFILE_REVISION=1
OLMOCR_MAX_INPUT_BYTES=50000000
OCR_PREPARATION_MAX_PAGES=200
QWEN_BASE_URL=https://llm.ilons.ru
QWEN_MODEL=Qwen/Qwen3.8-27B
QWEN_CONTEXT_WINDOW_SIZE=262000
ILONS_API_KEY=
# Used subset verified with this service on 2026-10-10; context size is still unverified.
QWEN_GENERATION_PATH=/v1/chat/completions
QWEN_API_FORMAT=openai-chat
QWEN_AUTH_HEADER=Authorization
QWEN_AUTH_SCHEME=Bearer
QWEN_TIMEOUT_SECONDS=300
# Client limits, not confirmed service limits or a tokenizer-based context budget.
QWEN_MAX_OUTPUT_TOKENS=8192
QWEN_MAX_INPUT_BYTES=750000
QWEN_MAX_RESPONSE_BYTES=4000000
